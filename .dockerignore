# VCS
.git/
.gitignore

# Frontend
shell/frontend/node_modules/
shell/frontend/dist/
shell/frontend/coverage/
shell/frontend/.eslintcache

# Extensions. The shell image does not use these, but the context is the repo
# root, so excluding them keeps the context transfer small. The extension
# images build from extensions/ and have their own .dockerignore.
extensions/node_modules/
extensions/*/node_modules/
extensions/dist/
extensions/*/dist/

# Backend build output
shell/backend/**/bin/
shell/backend/**/obj/

# Docs & tooling
docs/
plans/
helm/
*.md
.editorconfig
.vs/
.idea/
